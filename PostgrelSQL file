-- ANALYSIS OF THE AIRLINE DATA
-- 1. Number of Passengers from United States aged 80 or above
SELECT *
FROM airline_data_tb
WHERE nationality LIKE '%United States%' AND age>=80
LIMIT 10;

-- 2. Number of Male and Female Passengers
SELECT gender, COUNT(*) AS No_of_Passengers
FROM airline_data_tb
GROUP BY gender
ORDER BY gender DESC;

-- 3. Count by flight status (e.g., On Time, Delayed, Cancelled)
SELECT flight_status, COUNT(*) AS count
FROM airline_data_tb
GROUP BY flight_status
ORDER BY count DESC;

-- 4. Passenger coverage: unique passengers per nationality and top 10 nationalities
SELECT nationality, COUNT(DISTINCT passenger_id) AS unique_passengers
FROM airline_data_tb
GROUP BY nationality
ORDER BY unique_passengers DESC
LIMIT 10;

-- 5. Top 10 departure airports by volume
SELECT airport_name, COUNT(*) AS departures
FROM airline_data_tb
GROUP BY airport_name
ORDER BY departures DESC
LIMIT 10;

-- 6. Top 10 arrivals airports by volume
SELECT arrival_airport, COUNT(*) AS Arrivals
FROM airline_data_tb
GROUP BY arrival_airport
ORDER BY Arrivals DESC
LIMIT 10;

-- 7. On-time performance by departure airport - top 10 airports
SELECT airport_name,
       SUM(CASE WHEN flight_status = 'On Time' THEN 1 ELSE 0 END) AS on_time,
       SUM(CASE WHEN flight_status = 'Delayed' THEN 1 ELSE 0 END) AS delayed,
       SUM(CASE WHEN flight_status = 'Cancelled' THEN 1 ELSE 0 END) AS cancelled,
       COUNT(*) AS total_flights,
       ROUND(AVG(CASE WHEN flight_status = 'On Time' THEN 1.0 ELSE 0 END) * 100, 2) AS on_time_pct
FROM airline_data_tb
GROUP BY airport_name
ORDER BY on_time_pct DESC
LIMIT 10;

-- 8. Number of flight departures by month
SELECT EXTRACT(MONTH FROM departure_date) AS month,
       COUNT(*) AS flights
FROM airline_data_tb
GROUP BY month
ORDER BY month;

-- 9. Most experienced pilots based on number of flights piloted (top 10)
SELECT pilot_name, COUNT(*) AS flights_piloted
FROM airline_data_tb
GROUP BY pilot_name
ORDER BY flights_piloted DESC
LIMIT 10;

-- 10. Number of flights by airport continent (aggregate scope)
SELECT airport_continent, COUNT(*) AS flights
FROM airline_data_tb
GROUP BY airport_continent
ORDER BY flights DESC;
